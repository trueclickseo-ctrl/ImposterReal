# ================================================
# ImposterLand.com — Hostinger Apache .htaccess
# Performance + Security + Routing
# ================================================

# Serve modern image formats with correct content headers
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# Force HTTPS and Non-WWW (Canonical Domain)
RewriteEngine On
RewriteBase /

# 1. Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 2. Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 3. 301 Redirect deprecated /cyclopedia typo routes to /encyclopedia
RewriteRule ^cyclopedia/(.*)$ https://imposterland.com/encyclopedia/$1 [R=301,L]
RewriteRule ^cyclopedia/?$ https://imposterland.com/encyclopedia/ [R=301,L]
RewriteRule ^([a-z]{2})/cyclopedia/(.*)$ https://imposterland.com/$1/encyclopedia/$2 [R=301,L]
RewriteRule ^([a-z]{2})/cyclopedia/?$ https://imposterland.com/$1/encyclopedia/ [R=301,L]



# 5. Force trailing slash on all directories/routes (excluding files, static assets, sitemap.xml, and robots.txt)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.(jpg|jpeg|png|gif|webp|avif|svg|ico|css|js|json|xml|txt|woff|woff2|ttf)$ [NC]
RewriteCond %{REQUEST_URI} !sitemap\.xml$
RewriteCond %{REQUEST_URI} !robots\.txt$
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://imposterland.com/$1/ [R=301,L]

# ================================================
# GZIP Compression (major PageSpeed win)
# ================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/ttf

  # Remove browser bugs
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  Header append Vary User-Agent
</IfModule>

# ================================================
# Browser Caching (huge repeat-visit speed boost)
# ================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — do not cache to ensure users always get the latest build references
  ExpiresByType text/html "access plus 0 seconds"
  
  # CSS & JavaScript — long cache (filenames are hashed by Next.js)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # Images
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"

  # Data
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/ld+json "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

# Cache-Control headers for _next/static (immutable hashed files)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <Files "sitemap.xml">
    Header set Content-Type "application/xml; charset=utf-8"
  </Files>
</IfModule>

# ================================================
# Security Headers (fixes PageSpeed Best Practices)
# ================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ================================================
# Next.js Static Export Routing
# ================================================
DirectoryIndex index.html

# Serve pre-rendered HTML for all routes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Try adding /index.html for clean URLs
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>
